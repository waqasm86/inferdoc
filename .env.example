# InferDoc / Nebius Token Factory
NEBIUS_API_KEY=

# InferDoc runtime configuration
INFERDOC_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
INFERDOC_DOCTOR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
INFERDOC_BASE_URL=https://api.tokenfactory.nebius.com/v1/
INFERDOC_TIMEOUT_S=120
INFERDOC_MAX_RETRIES=2
INFERDOC_ARTIFACT_DIR=.inferdoc/runs

# Keep 0 for offline tests and set 1 only when intentionally spending live credits.
INFERDOC_RUN_LIVE_TESTS=0

# Optional external integrations. InferDoc core does not require these.
HUGGINGFACE_API_KEY=
LANGSMITH_API_KEY=
TAVILY_API_KEY=
TANDEM_API_KEY=
TOKOLA_API_KEY=
